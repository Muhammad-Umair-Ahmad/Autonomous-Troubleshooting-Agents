#!/bin/sh
set -eu

ip link set eth0 up
ip link set eth1 up
ip address replace 10.0.12.2/30 dev eth0
ip address replace 10.0.2.1/24 dev eth1
# Docker applies forwarding from lab.conf before startup.
if [ "$(sysctl -n net.ipv4.ip_forward)" != "1" ]; then
    sysctl -w net.ipv4.ip_forward=1
fi
ip route replace 10.0.1.0/24 via 10.0.12.1
